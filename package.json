{
  "name": "afterlife",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "tsx agents/seed.ts",
    "reset": "tsx agents/seed.ts --reset",
    "spike": "tsx agents/spike.ts",
    "relay:local": "npx -y @relaycast/engine@12.2.1 --db ./relay.db --port 8787",
    "server": "node --import tsx server/index.ts",
    "worker": "node --import tsx agents/worker.ts --name workergpt",
    "standby": "node --import tsx agents/standby.ts --name standbyclaude",
    "demo": "bash scripts/demo.sh",
    "demo:zombie": "ZOMBIE=1 bash scripts/demo.sh",
    "test:lease": "if [ \"$LEASE_BACKEND\" = terse ]; then tsx actor/test-lease-terse.ts; else tsx lease/test.ts; fi",
    "test:lease:terse": "tsx actor/test-lease-terse.ts",
    "actor:install": "cd actor && ~/.bun/bin/bun install",
    "actor:dev": "cd actor && ~/.bun/bin/bunx durable-actors dev",
    "actor:generate": "cd actor && ~/.bun/bin/bunx durable-actors generate --out-dir generated",
    "server:terse": "LEASE_BACKEND=terse node --import tsx server/index.ts",
    "demo:terse": "LEASE_BACKEND=terse bash scripts/demo.sh"
  },
  "dependencies": {
    "@agent-relay/sdk": "14.0.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
